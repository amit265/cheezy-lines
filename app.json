{
  "expo": {
    "name": "Cheezy Lines",
    "slug": "cheezy-lines",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cheezylines",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "requireFullScreen": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.destyastudio.cheezylines",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "NSPhotoLibraryUsageDescription": "Allows you to save and share cheesy lines as images.",
        "NSPhotoLibraryAddUsageDescription": "Allows you to save cheesy lines directly to your photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fde8aa"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mindcraftlearning.cheezylines",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "destyastudio.com",
              "pathPrefix": "/products/cheezylines"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fde8aa"
        }
      ],
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7433519007687449~8705553150",
          "iosAppId": "ca-app-pub-7433519007687449~6163351543",
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableHermes": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "cheezy-lines",
          "organization": "destya-studio"
        }
      ],
      "expo-web-browser",
      "@sentry/react-native/expo",
      "./plugins/withAndroidForceCoreSdk.js",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-tracking-transparency",
      "./withIosFmtWorkaround.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mindcraftlearning",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7df07ee-ed77-4692-a815-7252db2379c6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7df07ee-ed77-4692-a815-7252db2379c6"
    }
  }
}
